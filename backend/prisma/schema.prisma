generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Patient {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName           String         @map("first_name")
  lastName            String         @map("last_name")
  birthDate           DateTime       @map("birth_date") @db.Date
  gender              String
  occupation          String?
  consultationReason  String         @map("consultation_reason")
  status              String         @default("PENDING")
  avatarUrl           String?        @map("avatar_url")
  createdAt           DateTime       @default(now()) @map("created_at")

  measurements        Measurement[]
  medicalHistory      MedicalHistory[]
  diets               Diet[]

  @@map("patients")
}

model Measurement {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  date      DateTime @default(now())
  weight    Decimal
  height    Decimal
  isInitial Boolean  @default(false) @map("is_initial")

  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("measurements")
}

model MedicalHistory {
  id                              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId                       String  @map("patient_id") @db.Uuid
  chronicDiseasesHasCondition     Boolean @default(false) @map("chronic_diseases_has_condition")
  chronicDiseasesObservation      String? @map("chronic_diseases_observation")
  previousSurgeriesHasCondition   Boolean @default(false) @map("previous_surgeries_has_condition")
  previousSurgeriesObservation    String? @map("previous_surgeries_observation")
  allergiesHasCondition           Boolean @default(false) @map("allergies_has_condition")
  allergiesObservation            String? @map("allergies_observation")
  medicationsHasCondition         Boolean @default(false) @map("medications_has_condition")
  medicationsObservation          String? @map("medications_observation")
  smokesHasCondition              Boolean @default(false) @map("smokes_has_condition")
  smokesObservation               String? @map("smokes_observation")
  drinksAlcoholHasCondition       Boolean @default(false) @map("drinks_alcohol_has_condition")
  drinksAlcoholObservation        String? @map("drinks_alcohol_observation")

  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("medical_history")
}

model Diet {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId        String     @map("patient_id") @db.Uuid
  name             String
  durationDays     Int        @map("duration_days")
  targetKcalPerDay Int        @map("target_kcal_per_day")
  targetProtein    Decimal    @map("target_protein")
  targetFats       Decimal    @map("target_fats")
  targetCarbs      Decimal    @map("target_carbs")
  startDate        DateTime   @map("start_date") @db.Date
  createdAt        DateTime   @default(now()) @map("created_at")

  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  meals     DietMeal[]

  @@map("diets")
}

model DietMeal {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietId     String     @map("diet_id") @db.Uuid
  name       String
  orderIndex Int        @map("order_index")

  diet   Diet       @relation(fields: [dietId], references: [id], onDelete: Cascade)
  slots  DietSlot[]

  @@map("diet_meals")
}

model DietSlot {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mealId     String         @map("meal_id") @db.Uuid
  slotIndex  Int            @map("slot_index")

  meal   DietMeal       @relation(fields: [mealId], references: [id], onDelete: Cascade)
  items  DietSlotItem[]

  @@map("diet_slots")
}

model DietSlotItem {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slotId   String  @map("slot_id") @db.Uuid
  dayIndex Int     @map("day_index")
  foodName String  @map("food_name")
  grams    Decimal
  bedcaId  String? @map("bedca_id")

  slot   DietSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@map("diet_slot_items")
}